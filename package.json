{
  "name": "vidcut",
  "productName": "VidCut",
  "version": "0.21.1",
  "description": "Editor de vídeo simples com animações (Remotion + Electron)",
  "author": "Nuno Silva",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "bundle:remotion": "node scripts/bundle-remotion.mjs",
    "dev": "npm run bundle:remotion && concurrently -k -n vite,electron \"vite\" \"wait-on tcp:5173 && cross-env VIDCUT_DEV=1 electron .\"",
    "build": "tsc --noEmit && vite build && npm run bundle:remotion",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm install --no-save --force @remotion/compositor-win32-x64-msvc@4.0.533 && npm run build && electron-builder --win --x64 --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --x64 --publish never"
  },
  "dependencies": {
    "@remotion/install-whisper-cpp": "^4.0.533",
    "@remotion/renderer": "4.0.533",
    "fflate": "^0.8.3",
    "qrcode-generator": "^2.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.533"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@remotion/bundler": "4.0.533",
    "@remotion/lottie": "^4.0.533",
    "@remotion/player": "4.0.533",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "lottie-web": "^5.13.0",
    "resedit": "^2.0.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.3",
    "wait-on": "^9.0.0"
  },
  "build": {
    "appId": "app.vidcut.desktop",
    "productName": "VidCut",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "dist/**",
      "remotion-bundle/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@remotion/**",
      "remotion-bundle/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg"
        },
        {
          "target": "zip"
        }
      ],
      "category": "public.app-category.video",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "O VidCut usa o microfone para gravar narrações por cima do vídeo.",
        "LSApplicationCategoryType": "public.app-category.video",
        "NSCameraUsageDescription": "O VidCut usa a câmara para gravar o teu vídeo junto com o ecrã."
      }
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "AudioVideo",
      "icon": "build/icons",
      "maintainer": "Nuno Silva",
      "synopsis": "Editor de vídeo simples com animações",
      "executableArgs": [
        "--no-sandbox"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "desktop": {
        "entry": {
          "Name": "VidCut",
          "Comment": "Editor de vídeo simples com animações",
          "StartupWMClass": "VidCut"
        }
      }
    },
    "copyright": "© 2026 Nuno Silva",
    "dmg": {
      "title": "VidCut ${version}",
      "contents": [
        {
          "x": 150,
          "y": 200
        },
        {
          "x": 450,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 600,
        "height": 400
      }
    },
    "afterPack": "scripts/after-pack.cjs",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VidCut",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "language": "2070",
      "installerLanguages": [
        "pt_PT"
      ],
      "deleteAppDataOnUninstall": false
    },
    "publish": null,
    "portable": {
      "artifactName": "${productName}-${version}-Portatil.${ext}"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2 | libasound2t64"
      ]
    }
  },
  "homepage": "https://github.com/Qwerty-PT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Qwerty-PT/VidCut.git"
  },
  "license": "MIT"
}
