{
  "name": "vidcut",
  "productName": "VidCut",
  "version": "0.14.0",
  "description": "Editor de vídeo simples com animações (Remotion + Electron)",
  "author": "Nuno Silva",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "bundle:remotion": "node scripts/bundle-remotion.mjs",
    "dev": "npm run bundle:remotion && concurrently -k -n vite,electron \"vite\" \"wait-on tcp:5173 && cross-env VIDCUT_DEV=1 electron .\"",
    "build": "tsc --noEmit && vite build && npm run bundle:remotion",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@remotion/renderer": "4.0.533",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.533"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@remotion/bundler": "4.0.533",
    "@remotion/player": "4.0.533",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.3",
    "wait-on": "^9.0.0"
  },
  "build": {
    "appId": "app.vidcut.desktop",
    "productName": "VidCut",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "dist/**",
      "remotion-bundle/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@remotion/**",
      "remotion-bundle/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        {
          "target": "dmg"
        }
      ],
      "category": "public.app-category.video",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "O VidCut não grava áudio.",
        "LSApplicationCategoryType": "public.app-category.video"
      }
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "icon": "build/icon.png"
    },
    "copyright": "© 2026 Nuno Silva",
    "dmg": {
      "title": "VidCut ${version}",
      "contents": [
        {
          "x": 150,
          "y": 200
        },
        {
          "x": 450,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 600,
        "height": 400
      }
    }
  }
}
